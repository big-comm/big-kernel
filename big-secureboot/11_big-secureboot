#!/bin/sh
# big-secureboot: the "anti-cheat" entries, one per linux-big kernel.
#
# The same entries 10_linux writes, with what Easy Anti-Cheat Linux v2 checks
# added to the command line: lockdown (only signed modules load), no kexec
# and the IOMMU on. Kept as separate entries because lockdown also refuses
# modules built locally by DKMS and blocks hibernation; the normal entries
# stay as they were.
#
# 10_linux itself writes them, so root, subvolume, LUKS and initrd handling
# are exactly the normal entries'; here they are only filtered and renamed.
set -e

games="lockdown=integrity sysctl.kernel.kexec_load_disabled=1 iommu.passthrough=0 intel_iommu=on"

[ -x /etc/grub.d/10_linux ] || exit 0

GRUB_CMDLINE_LINUX_DEFAULT="${GRUB_CMDLINE_LINUX_DEFAULT} ${games}" \
GRUB_DISABLE_SUBMENU=true \
GRUB_DISABLE_RECOVERY=true \
GRUB_TOP_LEVEL='' \
  /etc/grub.d/10_linux 2>/dev/null |
awk '
  # With the submenu disabled every kernel is a top-level entry block,
  # "menuentry ... {" to "}". Keep the main one of each linux-big kernel.
  /^menuentry / {
    sub(/\047 --class/, " - anti-cheat\047 --class")
    block = $0 "\n"; inside = 1; next
  }
  inside {
    block = block $0 "\n"
    if ($0 ~ /^}/) {
      inside = 0
      if (block ~ /vmlinuz-linux-big/ && block ~ /-advanced-/) {
        gsub(/\047gnulinux-/, "\047big-secureboot-", block)
        printf "%s", block
      }
    }
  }
'
