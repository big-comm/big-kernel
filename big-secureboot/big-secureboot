#!/bin/bash
# big-secureboot: Secure Boot for BigCommunity, with the BigCommunity key.
#
#   big-secureboot enable [--password PW]      install it and schedule the key
#                                              (the package install runs it)
#   big-secureboot status                      what is in place, and the
#                                              Easy Anti-Cheat checks
#   big-secureboot disable [--remove-key]      take it out of the boot
#                                              (--remove-key: the MOK too)
#   big-secureboot refresh                     copy the loaders to the ESP
#                                              again (the package upgrade)
#
# The boot chain is Fedora's shim (signed by Microsoft) -> a GRUB signed with
# the BigCommunity key -> linux-big, also signed with it. They live in their
# own ESP directory, \EFI\big-secureboot, with their own firmware boot entry:
# the grub package's hooks reinstall \EFI\<distributor>\grubx64.efi on every
# update and would overwrite anything kept there. That GRUB reads the usual
# /boot/grub/grub.cfg, so the menu stays the one update-grub writes.
#
# The key is enrolled as a MOK: "enable" schedules it (mokutil --import), and
# on the next boot shim shows a blue screen (MokManager) where the user
# confirms it with the password given here. That screen is the one manual
# step, and it is deliberate: only someone at the machine can add a key.
#
# The key goes into shim's own list (MokList), not into the firmware's
# keys: PK, KEK, db and dbx stay as the manufacturer left them, Microsoft's
# included, which the firmware of GPUs and other devices (option ROMs) needs.
#
# Easy Anti-Cheat also wants the kernel locked down, kexec off and the IOMMU
# on. linux-big locks itself down when booted with Secure Boot
# (CONFIG_LOCK_DOWN_IN_EFI_SECURE_BOOT); the package turns kexec off
# (/usr/lib/sysctl.d/90-big-secureboot.conf) and adds intel_iommu=on to the
# boot menu (/etc/default/grub.d/90-big-secureboot.cfg). The boot entries
# stay the usual ones.

set -euo pipefail

SHARE=/usr/share/big-secureboot
ESP_DIR=EFI/big-secureboot
LABEL="BigCommunity Secure Boot"
LOADER='\EFI\big-secureboot\shimx64.efi'
CERT=$SHARE/big-secureboot.der
DEFAULT_PASSWORD=big

say() { printf '%s\n' "$*"; }
die() { printf 'big-secureboot: %s\n' "$*" >&2; exit 1; }
need_root() { (( EUID == 0 )) || die "run it as root (sudo big-secureboot $1)"; }
need_uefi() { [[ -d /sys/firmware/efi ]] || die "this system did not boot in UEFI mode; Secure Boot needs UEFI"; }

# The ESP mount point: what systemd finds, or the usual places.
find_esp() {
  local esp
  esp=$(bootctl --print-esp-path 2>/dev/null) || esp=
  if [[ -z $esp ]]; then
    for esp in /boot/efi /efi /boot; do
      [[ $(findmnt -no FSTYPE "$esp" 2>/dev/null) == vfat ]] && break
      esp=
    done
  fi
  [[ -n $esp ]] || die "EFI system partition (ESP) not found"
  printf '%s\n' "$esp"
}

enabled() { local esp; esp=$(find_esp) && [[ -f $esp/$ESP_DIR/shimx64.efi ]]; }

# The GRUB config next to the loader: finds /boot/grub and hands over to the
# grub.cfg update-grub writes. Unlocks LUKS first when /boot is encrypted,
# as grub-install does.
write_stub() {
  local target=$1 uuid relpath crypto=
  uuid=$(grub-probe --target=fs_uuid /boot/grub)
  relpath=$(grub-mkrelpath /boot/grub)
  if grub-probe --target=abstraction /boot/grub 2>/dev/null | grep -qw cryptodisk; then
    local id
    for id in $(grub-probe --target=cryptodisk_uuid /boot/grub); do
      crypto+="cryptomount -u $id"$'\n'
    done
  fi
  cat > "$target" <<EOF
# Written by big-secureboot: finds /boot/grub and loads its grub.cfg.
${crypto}search --no-floppy --fs-uuid --set=root $uuid
set prefix=(\$root)$relpath
configfile \$prefix/grub.cfg
EOF
}

install_loaders() {
  local esp dir
  esp=$(find_esp)
  dir=$esp/$ESP_DIR
  mkdir -p "$dir"
  # shim looks for grubx64.efi and mmx64.efi next to itself.
  install -m644 "$SHARE/shimx64.efi" "$SHARE/mmx64.efi" "$SHARE/grubx64.efi" "$dir/"
  write_stub "$dir/grub.cfg.new" && mv "$dir/grub.cfg.new" "$dir/grub.cfg"
}

boot_entries() { efibootmgr 2>/dev/null | sed -n "s/^Boot\([0-9A-Fa-f]\{4\}\)\*\? $LABEL\b.*/\1/p"; }

create_boot_entry() {
  local esp src disk part n
  esp=$(find_esp)
  src=$(findmnt -no SOURCE "$esp")
  disk=/dev/$(lsblk -no PKNAME "$src")
  part=$(<"/sys/class/block/${src##*/}/partition")
  for n in $(boot_entries); do efibootmgr -q -b "$n" -B; done
  # --create puts the new entry first in BootOrder.
  efibootmgr -q --create --disk "$disk" --part "$part" --loader "$LOADER" --label "$LABEL"
}

# By fingerprint: mokutil's own wording changes once the kernel has loaded
# the key ("already in the built-in trusted keyring").
fingerprint() { openssl x509 -inform DER -in "$CERT" -noout -fingerprint -sha1 | sed 's/.*=//; s/://g' | tr 'A-F' 'a-f'; }
has_key() { mokutil "$1" 2>/dev/null | sed 's/://g' | tr 'A-F' 'a-f' | grep -q "$(fingerprint)"; }
# Before scheduling the key: what would make the blue screen pointless.
#  - shim is signed with Microsoft's CAs for other systems (the "3rd Party"
#    UEFI CA, 2011 and 2023). Some machines ("Secured-core" PCs) leave both
#    out of db until "Allow Microsoft 3rd Party UEFI CA" is turned on in the
#    firmware settings; shim would then never start.
#  - The key and the request take room in the firmware's variable storage,
#    which efivarfs reports through statfs. 8 KiB covers them with margin.
#    Firmware crash dumps (efi-pstore, dump-*) are what usually fills it.
DB_VAR=/sys/firmware/efi/efivars/db-d719b2cb-3d3a-4596-a3bc-dad00e67656f
NVRAM_NEEDED=8192
firmware_trusts_shim() {
  [[ -r $DB_VAR ]] || return 0  # no db (setup mode): nothing to tell yet
  grep -aq -e 'Microsoft Corporation UEFI CA 2011' -e 'Microsoft UEFI CA 2023' "$DB_VAR"
}
nvram_free() {  # bytes, or nothing when the kernel does not report it
  local size avail total
  read -r size avail total < <(stat -f -c '%S %a %b' /sys/firmware/efi/efivars 2>/dev/null) || return 0
  (( total > 0 )) && echo $((size * avail))
}
key_enrolled() { has_key --list-enrolled; }
key_pending() { has_key --list-new; }

cmd_enable() {
  need_root enable
  local password=$DEFAULT_PASSWORD auto=0
  while (( $# )); do
    case $1 in
      --password) password=${2:?--password needs a value}; shift 2 ;;
      # From the package install: where it cannot run (a chroot or a
      # container, building an ISO or installing a system, or a machine that
      # did not boot in UEFI mode) say so and leave pacman alone.
      --auto) auto=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done
  if (( auto )); then
    local why=
    if [[ ! -d /sys/firmware/efi ]]; then
      why="the system did not boot in UEFI mode"
    elif [[ $(stat -Lc %d:%i / 2>/dev/null) != "$(stat -Lc %d:%i /proc/1/root/ 2>/dev/null)" ]]; then
      why="inside a chroot (an installation or an ISO build)"
    elif [[ -n ${container:-} || -e /run/systemd/container || -e /run/.containerenv || -e /.dockerenv ]]; then
      why="inside a container"
    fi
    if [[ -n $why ]]; then
      say "big-secureboot: installed, but not enabled: $why."
      say "Enable it once the system is running: sudo big-secureboot enable"
      return 0
    fi
  fi
  need_uefi
  firmware_trusts_shim ||
    die "this firmware does not accept boot loaders signed by Microsoft for other systems.
Turn on \"Allow Microsoft 3rd Party UEFI CA\" in the firmware settings, then run: sudo big-secureboot enable"
  if ! key_enrolled; then
    local free
    free=$(nvram_free)
    if [[ -n $free ]] && (( free < NVRAM_NEEDED )); then
      die "the firmware has $((free / 1024)) KiB free for its variables, not enough for the BigCommunity key ($((NVRAM_NEEDED / 1024)) KiB).
Old crash dumps kept by the firmware usually fill it: ls /sys/firmware/efi/efivars/dump-*"
    fi
  fi
  install_loaders
  create_boot_entry
  update-grub >/dev/null 2>&1 || grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 ||
    say "Warning: the GRUB menu could not be updated; run update-grub."
  sysctl -q -p /usr/lib/sysctl.d/90-big-secureboot.conf || true
  say "Boot loaders installed in $(find_esp)/$ESP_DIR, boot entry \"$LABEL\" created."
  if key_enrolled; then
    say "The BigCommunity key is already enrolled."
  else
    # A key already pending keeps the password of its request: mokutil skips
    # it ("already in the enrollment request") and exits 0, and the password
    # printed below would not be the one MokManager asks for (1.1.0 used
    # another one). Start the request over, so it always holds this one.
    if key_pending; then
      mokutil --revoke-import >/dev/null || die "mokutil --revoke-import failed"
    fi
    printf '%s\n%s\n' "$password" "$password" | mokutil --import "$CERT" >/dev/null ||
      die "mokutil --import failed"
    cat <<EOF

One step is left, at the next boot, done only once:
  1. Restart. A blue screen appears (MokManager).
  2. Press a key, choose "Enroll MOK", then "Continue" and "Yes".
  3. Type the password: $password
  4. Choose "Reboot".
Then turn on Secure Boot in the computer's firmware settings (UEFI), if it
is off. With Secure Boot on, the kernel locks itself down: only signed
kernel modules load, as Easy Anti-Cheat requires.
EOF
  fi
}

cmd_refresh() {
  need_root refresh
  [[ -d /sys/firmware/efi ]] && enabled || exit 0
  install_loaders
}

cmd_disable() {
  need_root disable
  local remove_key=0 esp n
  while (( $# )); do
    case $1 in
      --remove-key) remove_key=1 ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done
  if [[ -d /sys/firmware/efi ]]; then
    for n in $(boot_entries); do efibootmgr -q -b "$n" -B; done
    esp=$(find_esp) && rm -rf -- "${esp:?}/$ESP_DIR"
  fi
  say "BigCommunity Secure Boot taken out of the boot."
  if mokutil --sb-state 2>/dev/null | grep -q 'SecureBoot enabled'; then
    say "Warning: Secure Boot is on. Turn it off in the firmware settings before restarting,"
    say "or the system may not start."
  fi
  if (( remove_key )) && key_enrolled; then
    printf '%s\n%s\n' "$DEFAULT_PASSWORD" "$DEFAULT_PASSWORD" | mokutil --delete "$CERT" >/dev/null &&
      say "Key removal scheduled: confirm it on the blue screen at the next boot (password: $DEFAULT_PASSWORD)."
  fi
}

# The checks of Easy Anti-Cheat Linux v2, as Bazzite's check-anticheat does.
cmd_status() {
  local pass=0 fail=0
  check() { if eval "$2"; then say "  [ok]    $1"; pass=$((pass + 1)); else say "  [no]    $1"; fail=$((fail + 1)); fi; }
  say "Installation:"
  check "firmware accepts shim (Microsoft 3rd Party UEFI CA in db)" firmware_trusts_shim
  check "boot loaders in the ESP and boot entry" "enabled && [[ -n \$(boot_entries) ]]"
  if key_enrolled; then check "BigCommunity key enrolled" true
  elif key_pending; then check "BigCommunity key enrolled (pending: confirm it on the blue screen when restarting)" false
  else check "BigCommunity key enrolled" false; fi
  say "Easy Anti-Cheat requirements:"
  check "Secure Boot on" "mokutil --sb-state 2>/dev/null | grep -q 'SecureBoot enabled'"
  check "TPM 2.0" "[[ \$(cat /sys/class/tpm/tpm0/tpm_version_major 2>/dev/null) == 2 ]]"
  check "kernel linux-big" "[[ \$(uname -r) == *-big ]]"
  check "no unsigned module loaded" "(( (\$(cat /proc/sys/kernel/tainted) & 8192) == 0 ))"
  check "IOMMU on" "compgen -G '/sys/class/iommu/*' >/dev/null"
  check "lockdown integrity" "grep -qE '\[(integrity|confidentiality)\]' /sys/kernel/security/lockdown 2>/dev/null"
  check "kexec off" "[[ \$(cat /proc/sys/kernel/kexec_load_disabled) == 1 ]]"
  check "BPF LSM" "[[ ,\$(cat /sys/kernel/security/lsm 2>/dev/null), == *,bpf,* ]]"
  (( fail == 0 ))
}

case ${1:-} in
  enable)  shift; cmd_enable "$@" ;;
  disable) shift; cmd_disable "$@" ;;
  refresh) cmd_refresh ;;
  status)  cmd_status ;;
  *) sed -n '2,12s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
