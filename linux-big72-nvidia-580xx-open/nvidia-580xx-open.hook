# Points depmod at the build of @KERNEL_PKG@-nvidia-580xx-open that matches the
# installed nvidia-580xx-utils: after 60-depmod, before mkinitcpio and dkms.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/modules/*/extramodules/@KERNEL_PKG@-nvidia-580xx-open/*

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = nvidia-580xx-utils

[Action]
Description = Selecting the @KERNEL_PKG@-nvidia-580xx-open build for nvidia-580xx-utils...
When = PostTransaction
Exec = /usr/share/libalpm/scripts/@KERNEL_PKG@-nvidia-580xx-select @KERNEL_PKG@-nvidia-580xx-open
