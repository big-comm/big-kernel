# Removes the depmod override before the package goes: once it is gone, its
# PostTransaction hook would not run any more.
[Trigger]
Type = Path
Operation = Remove
Target = usr/lib/modules/*/extramodules/@KERNEL_PKG@-nvidia/*

[Action]
Description = Removing the @KERNEL_PKG@-nvidia depmod override...
When = PreTransaction
Exec = /usr/share/libalpm/scripts/@KERNEL_PKG@-nvidia-select @KERNEL_PKG@-nvidia --remove
