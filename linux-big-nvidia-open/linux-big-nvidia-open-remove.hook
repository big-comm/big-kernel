# Removes the depmod override before the package goes: once it is gone, its
# PostTransaction hook would not run any more.
[Trigger]
Type = Path
Operation = Remove
Target = usr/lib/modules/*/extramodules/linux-big-nvidia-open/*

[Action]
Description = Removing the linux-big-nvidia-open depmod override...
When = PreTransaction
Exec = /usr/share/libalpm/scripts/linux-big-nvidia-select linux-big-nvidia-open --remove
