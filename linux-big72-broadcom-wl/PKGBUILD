# Maintainer: Tales A. Mendonça <talesam@gmail.com>
#
# Broadcom 802.11 Linux STA wireless driver for linux-big, built from broadcom-wl-dkms.
#
# Nothing here is edited by hand when a driver or the kernel is updated:
#   - the driver version is the broadcom-wl-dkms currently in the repositories the
#     build runs against, asked from pacman;
#   - the kernel is the linux-big described by ../<_kernel_pkg>/PKGBUILD, which
#     sets the exact dependency and the pkgrel.
# The dependency on the exact kernel is deliberate: when a new linux-big is
# published before its modules, pacman holds the kernel update back instead
# of booting a kernel without Wi-Fi.
#
# Do not reference the pkgname or url variables anywhere in this file: a
# testing build in the CI expands them textually.

# The kernel this directory builds for. linux-big72-<module> and
# linux-big73-<module> are the same PKGBUILD but for this line.
_kernel_pkg=linux-big72
_kernel_pkgbuild=../$_kernel_pkg/PKGBUILD
_kpkgver=$(sed -n 's/^pkgver=//p' "$_kernel_pkgbuild")
_kpkgrel=$(sed -n 's/^pkgrel=//p' "$_kernel_pkgbuild")
_kernel="${_kpkgver}-${_kpkgrel}"
_kernver="${_kernel}-big"

# pkgrel encodes the kernel, so every new linux-big is an upgrade of this
# package too: 7.2.7-2 -> 7020702, 7.3.0-1 -> 7030001.
_kernel_rel() {
  local major minor patch
  IFS=. read -r major minor patch <<< "$_kpkgver"
  printf '%d%02d%02d%02d' "$major" "$minor" "${patch:-0}" "$_kpkgrel"
}

# A change here that must reach users on the same kernel and driver (a fixed
# dependency, say) needs a new version: pacman does not reinstall an equal
# one, and the repository's CDN keeps serving the old file under the old
# name. Set _rebuild_for to the kernel it is for (_kernel, above) and
# _rebuild to 1, 2...: pkgrel becomes 7020702.1. A new kernel ignores both,
# so they never need resetting.
_rebuild_for=
_rebuild=
_pkgrel() {
  if [[ -n $_rebuild && $_rebuild_for == "$_kernel" ]]; then
    echo "$(_kernel_rel).$_rebuild"
  else
    _kernel_rel
  fi
}

# The version of a package in the repositories, without its pkgrel.
_repo_version() {
  LC_ALL=C pacman -Si "$1" 2>/dev/null | awk -F': ' '/^Version/ { sub(/-[^-]*$/, "", $2); print $2; exit }'
}

_check_kernel() {
  local headers
  headers="$(</usr/src/$_kernel_pkg/version)"
  if [[ $headers != "$_kernver" ]]; then
    error "$_kernel_pkg-headers is $headers, but $_kernel_pkgbuild describes $_kernver"
    return 1
  fi
}

pkgname=$_kernel_pkg-broadcom-wl
pkgver=$(_repo_version broadcom-wl-dkms)
pkgrel=$(_pkgrel)
pkgdesc="Broadcom 802.11 Linux STA wireless driver for $_kernel_pkg"
arch=('x86_64')
url="https://www.broadcom.com/support/download-search/?pf=Wireless+LAN+Infrastructure"
license=('custom')
groups=("$_kernel_pkg-extramodules")
depends=("$_kernel_pkg=$_kernel")
makedepends=("$_kernel_pkg-headers=$_kernel" "broadcom-wl-dkms=$pkgver")
provides=('broadcom-wl')
options=('!strip' '!debug')

build() {
  _check_kernel
  fakeroot dkms build --dkmstree "$srcdir" -m "broadcom-wl/$pkgver" -k "$_kernver"
}

package() {
  install -Dm644 -t "$pkgdir/usr/lib/modules/$_kernver/extramodules" \
    "broadcom-wl/$pkgver/$_kernver/$CARCH/module/"*
  find "$pkgdir" -name '*.ko' -exec zstd --rm -19 {} +
  install -Dm644 -t "$pkgdir/usr/share/licenses/$_kernel_pkg-broadcom-wl/" \
    /usr/share/licenses/broadcom-wl-dkms/*
  install -Dm644 /usr/lib/modprobe.d/broadcom-wl-dkms.conf \
    "$pkgdir/usr/lib/modprobe.d/$_kernel_pkg-broadcom-wl.conf"
}
