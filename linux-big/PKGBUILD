# Maintainer: Tales A. Mendonça <talesam@gmail.com>
#
# linux-big: the names that follow BigCommunity's current kernel series.
#
# Each kernel series is a package of its own, as in Manjaro (linux72,
# linux73): linux-big72, linux-big73, their headers and their modules
# (linux-big73-nvidia, ...). They install side by side, each with its own
# /boot/vmlinuz-linux-bigNN, so a new series never takes away the one that
# was working.
#
# The packages built here install nothing. linux-big, linux-big-headers and
# linux-big-<module> each depend on the same package of every series in
# _series, so:
#   - an ISO or a user that asks for linux-big gets the series listed;
#   - a machine that has linux-big from before the series were split (it
#     was the 7.2 kernel itself) moves to these on its next update: to
#     linux-big72, the same 7.2.15 under its new name;
#   - a series in the repository but not in _series (7.3, while it is in
#     testing) reaches only who installs it by name: linux-big73;
#   - when that series is approved for everyone it is put first in _series,
#     next to the one machines have, so they get it without losing the one
#     that was working; the older one is dropped later, and machines keep it
#     installed until they remove it.
#
# Publish this only after every package it depends on is in the branch, or
# pacman cannot update: the module watcher does that for testing.
#
# Do not reference the pkgname or url variables anywhere in this file: a
# testing build in the CI expands them textually.

# The series linux-big follows, current first. 7.3 stays out while it is in
# testing: who wants it there installs linux-big73 by name.
_series=(72)
# The kernel modules every series is built with: one directory per series,
# linux-big<NN>-<module>.
_modules=(
  acpi_call
  broadcom-wl
  nvidia
  nvidia-390xx
  nvidia-580xx
  nvidia-580xx-open
  nvidia-open
  r8168
  rtl8723bu
  tp_smapi
  vhba-module
  virtualbox-host-modules
  zfs
)

pkgbase=linux-big
# The current series. The epoch puts these above every linux-big* package
# from before the split (linux-big 7.2.15-1, linux-big-nvidia 615.71.09-...).
pkgver=7.2
pkgrel=1
epoch=1
arch=('x86_64')
url="https://github.com/big-comm/big-kernel"
license=('GPL-2.0-only')

# What linux-big<suffix> depends on: linux-big73<suffix>, linux-big72<suffix>, ...
_each_series() {
  local series
  for series in "${_series[@]}"; do
    echo "linux-big$series$1"
  done
}

_package() {
  pkgdesc="The BigCommunity kernel, current series ($pkgver)"
  depends=($(_each_series ""))
}

_package-headers() {
  pkgdesc="Headers for the BigCommunity kernel, current series ($pkgver)"
  depends=($(_each_series -headers))
}

_package_module() {
  pkgdesc="The $1 module for the BigCommunity kernel, current series ($pkgver)"
  depends=($(_each_series "-$1"))
}

pkgname=(
  "$pkgbase"
  "$pkgbase-headers"
  "${_modules[@]/#/$pkgbase-}"
)
eval "package_$pkgbase() { _package; }"
eval "package_$pkgbase-headers() { _package-headers; }"
for _m in "${_modules[@]}"; do
  eval "package_$pkgbase-$_m() { _package_module $_m; }"
done

# vim:set ts=8 sts=2 sw=2 et:
